{
  "name": "aozora-toolkit",
  "productName": "aozoratoolkit",
  "version": "1.1.1",
  "description": "toolkit for aozora bunko",
  "main": "build/aozoratoolkit.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "start": "npm run build && electron .",
    "build-win": "npm run build && electron-builder --win --x64",
    "build-win-publish": "npm run build && electron-builder --win --x64 --publish always"
  },
  "keywords": [
    "aozora",
    "book",
    "editor",
    "free"
  ],
  "author": {
    "name": "numthree-uchimura (https://github.com/N3-uchimura/)",
    "email": "uchimura@numthree.net"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "@ghostery/adblocker-puppeteer": "^2.18.1",
    "chardet": "^2.2.0",
    "cross-fetch": "^4.1.0",
    "csv": "^6.4.1",
    "electron-log": "^5.4.0",
    "iconv-lite": "^0.6.3",
    "kanadaku": "^1.1.0",
    "node-cache": "^5.1.2",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.1",
    "electron-updater": "^6.8.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "net.numthree.aozoratoolkit",
    "productName": "aozoratoolkit",
    "compression": "maximum",
    "asarUnpack": [
      "node_modules/@electron-internal/extract-zip"
    ],
    "files": [
      "build/**/*",
      "package.json",
      "!dist/**/*",
      "!src/**/*",
      "!.gitignore",
      "!.vscode"
    ],
    "extraResources": [
      "assets",
      "www/**/*"
    ],
    "squirrelWindows": {},
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "MIT"
}
